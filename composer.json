{
    "name": "vuthaihoc/pdfparser",
    "description": "Fork of prinsfrank/pdfparser: PDF parsing, text & image extraction, plus an experimental Imagick page renderer, HTTP Range reading and parser fixes",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/vuthaihoc/pdfparser",
    "support": {
        "source": "https://github.com/vuthaihoc/pdfparser",
        "issues": "https://github.com/vuthaihoc/pdfparser/issues"
    },
    "autoload": {
        "psr-4": {
            "PrinsFrank\\PdfParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrinsFrank\\PdfParser\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-zlib": "*",
        "prinsfrank/glyph-lists": "^1.0",
        "prinsfrank/markdown-dom": "^0.2.1"
    },
    "suggest": {
        "ext-imagick": "To render pages to images (PrinsFrank\\PdfParser\\Render)",
        "ext-curl": "To read PDFs over HTTP Range requests (HttpRangeStream)"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpstan/phpstan": "2.3.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "7.4.18"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --allow-risky=yes --dry-run",
        "cs:fix": "php-cs-fixer fix --allow-risky=yes",
        "stan": "phpstan analyse --memory-limit 4G -v",
        "unit": "phpunit --testsuite=Unit",
        "feature": "phpunit --testsuite=Feature",
        "update-content": "php -d memory_limit=2G ./tests/Samples/update-content"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    }
}
